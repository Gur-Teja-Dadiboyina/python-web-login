pipeline {
    agent any

    environment {
        IMAGE_NAME = "python-web-login"
        CONTAINER_NAME = "python-web-login-container"
        APP_PORT = "5000"
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/Gur-Teja-Dadiboyina/python-web-login.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${IMAGE_NAME}:latest ."
            }
        }

        stage('Run Container') {
            steps {
                sh """
                docker rm -f ${CONTAINER_NAME} || true
                docker run -d \
                  -p ${APP_PORT}:5000 \
                  --name ${CONTAINER_NAME} \
                  ${IMAGE_NAME}:latest
                """
            }
        }

        stage('Health Check') {
            steps {
                sh "sleep 10"
                sh "curl -f http://localhost:${APP_PORT} || exit 1"
            }
        }

        stage('Monitoring Instructions') {
            steps {
                echo "App running at: http://<EC2-IP>:${APP_PORT}"
                echo "Add this to Prometheus:"
                echo "targets: ['localhost:${APP_PORT}']"
            }
        }
    }

    post {
        success {
            echo "Build & Deployment Successful 🚀"
        }
        failure {
            echo "Something went wrong ❌"
        }
    }
}
